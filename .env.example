# Copy this file to .env and fill in what you need. .env is gitignored --
# never commit real credentials.

# ---- Database ----
# Unset (default): SQLite, stored at APEX_DB_PATH (or app/apex_pilot.db).
# Fine for local dev and the test suite -- fast, no network, no setup.
#
# Set DATABASE_URL to switch to Postgres (e.g. Supabase) instead -- no
# other config needed, app/db.py picks it up automatically. Use the
# "Session pooler" connection string from Supabase (Project Settings ->
# Database), not the direct connection -- better suited to a web app
# opening/closing a connection per request. Percent-encode special
# characters in the password (e.g. "!" -> "%21").
# DATABASE_URL=postgresql://postgres:your-password@db.your-project-ref.supabase.co:5432/postgres

# APEX_DB_PATH=app/apex_pilot.db

# ---- Gmail (OBJ-016) ----
# Both required together to enable real sending/reply-polling. Generate an
# App Password at https://myaccount.google.com/apppasswords (needs 2-Step
# Verification turned on first). Can also be set from the Admin tab at
# runtime instead -- that takes effect immediately, no restart needed, and
# is the recommended way for a deployed instance since it doesn't require
# redeploying to change credentials.
# GMAIL_ADDRESS=you@gmail.com
# GMAIL_APP_PASSWORD=your16charapppassword

# How often (minutes) the inbox poller checks for replies. Default 5.
# POLL_INTERVAL_MINUTES=5

# ---- AI Brain: Claude reply drafting (bring your own Anthropic subscription) ----
# Optional. Upgrades reply drafting from rule-based keyword matching to
# Claude-generated drafts, grounded in this app's own Knowledge Base Q&A
# entries and stock catalog. Each deployment brings its own key -- get one
# at https://console.anthropic.com/settings/keys. Can also be set from the
# Admin tab at runtime instead (recommended for a deployed instance, same
# reasoning as Gmail above). Falls back to the rule-based composer with no
# key set -- the app works fully without this.
# ANTHROPIC_API_KEY=sk-ant-...
# ANTHROPIC_MODEL=claude-sonnet-5
